# Banco SQLite local. O diretório será criado automaticamente.
DATABASE_PATH=./data/news.db

# Integração de busca real (https://gnews.io). Sem a chave, o app usa dados de demonstração.
GNEWS_API_KEY=

# Protege a rota de atualização automática /api/cron/update.
CRON_SECRET=troque-por-um-segredo-forte
